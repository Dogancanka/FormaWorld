# --- Autodesk Platform Services ---------------------------------------------
# Create a Traditional Web App in the APS developer portal and register this
# exact callback URL in the app settings.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_CALLBACK_URL=http://localhost:3000/api/auth/callback

# Optional extra OAuth scopes, space or comma separated.
#
# FormaWorld needs data:read, data:write and account:read, and always asks for
# those. Add user-profile:read here (and grant it to the same APS application)
# to key saved progress to the Autodesk account, so a reader's level follows
# them to another browser or machine. Without it, progress is stored against a
# long-lived cookie and stays with one browser.
#
# Only list scopes the APS application is actually registered for: an unknown
# scope makes the whole sign-in fail.
APS_EXTRA_SCOPES=

# --- This application --------------------------------------------------------
# At least 32 random characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Where saved reader state is written (XP, answered digest lines, and the
# snapshot the next "while you were away" is diffed against). Defaults to
# ./data next to the app. In Docker this is the mounted volume.
FORMAWORLD_DATA_DIR=
